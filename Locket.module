#!name=Locket 💛
#!desc=Mở khóa đầy đủ tính năng của Locket Gold ^^
# 🩷 Discord: https://discord.gg/rabbitstore
# 🤍 Release by: Xunn | TheSword Studio
#!author=Xunn[https:instagram.com/itzxunn_]

[General]
user-agent = Locket/1.0.0 (iPhone; iOS 27.2; Scale/3.00)

[Script]
# ~ Dev by: Xunn
# ~ Enhanced for Shadowrocket, Surge, & LanceX
# RevenueCat Response
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/ItzXunn/xunn/refs/heads/main/Locket_fix.js, requires-body=true, max-size=-1, timeout=60

# RevenueCat Request Header
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/ItzXunn/xunn/refs/heads/main/deleteHeader.js, timeout=60

# Locket Firebase Remote Config
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/ItzXunn/xunn/refs/heads/main/forceGold.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com

# ~ Xunn
